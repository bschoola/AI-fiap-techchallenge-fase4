# Copie para .env e preencha (NUNCA faça commit do .env). Passo a passo: docs/azure-setup.md

# Azure AI Speech (recurso "Speech")
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Azure AI Language (recurso "Language service")
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://SEU-RECURSO.cognitiveservices.azure.com/

# Azure OpenAI (OPCIONAL: gerar áudios de demonstração com scripts/generate_consulta_audio.py
# e avaliar o tom de voz, ver VOICE_TONE_ENABLED abaixo)
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_AUDIO_DEPLOYMENT=gpt-audio
AZURE_OPENAI_TTS_DEPLOYMENT=gpt-4o-mini-tts
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Tom de voz (OPCIONAL): o modelo de áudio acima OUVE a gravação e descreve esforço respiratório,
# cansaço e tom emocional. Usa AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_KEY e AZURE_OPENAI_AUDIO_DEPLOYMENT.
# As pausas e o tom medidos no áudio (prosódia) funcionam sempre, mesmo com isto desligado.
VOICE_TONE_ENABLED=false

# true = serviços simulados, sem chamar o Azure (útil para desenvolver/testar)
MOCK_AZURE=false

# Banco: no Docker o compose já aponta para o Postgres; fora dele, SQLite local basta
DATABASE_URL=sqlite:///data/vitaltrace.db

# Troque em qualquer ambiente que não seja a sua máquina
SECRET_KEY=troque-esta-chave-em-producao

# Vídeo: auto | yolo | motion  (auto = YOLOv8-pose se instalado, senão OpenCV)
VIDEO_BACKEND=auto
VIDEO_DETAIL_FPS=5

# Vídeo por link do YouTube (baixa só os primeiros segundos, em baixa resolução). false = esconde o campo
YOUTUBE_ENABLED=true
